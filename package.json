{
  "name": "claude-jev",
  "version": "0.1.1",
  "description": "Semantic guardrails and output verification for Claude Code powered by TypeSafe Jev",
  "type": "module",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "bin": {
    "claude-jev": "bin/claude-jev"
  },
  "files": [
    ".claude-plugin",
    "bin",
    "dist",
    "hooks",
    "skills",
    "docs/type-safe-integration.md",
    "docs/pre-tool-judgments.md",
    "docs/output-judgments.md",
    "docs/reliability-and-privacy.md",
    "docs/end-to-end-example.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-strip-types --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "validate:plugin": "claude plugin validate . --strict"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr-dimitru/claude-jev-plugin.git"
  },
  "homepage": "https://github.com/dr-dimitru/claude-jev-plugin#readme",
  "keywords": [
    "claude-code",
    "plugin",
    "typesafe",
    "jev",
    "guardrails"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
