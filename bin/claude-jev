#!/usr/bin/env node

import * as path from "node:path";
import { askTypeSafe, TypeSafeError, redact, boundText, isLocalEndpoint } from "../dist/client.js";
import {
  DecisionInputError,
  MAX_DECISION_INPUT_BYTES,
  parseDecisionRequest,
} from "../dist/decision.js";
import { canCallTypeSafe, loadConfig } from "../dist/config.js";
import { buildGateState } from "../dist/state.js";
import { sessionStore } from "../dist/hook-io.js";
import { GATE_QUESTIONS, evaluateGate } from "../dist/gate.js";

const STRICT_COMMANDS = new Set(["check", "ask"]);

function parseArgs(rawArgs) {
  const positionals = [];
  let sessionId;
  let scratchpadDir;
  let cwd;
  let help = false;

  for (let i = 0; i < rawArgs.length; i++) {
    const arg = rawArgs[i];

    if (arg === "--help" || arg === "-h") {
      help = true;
    } else if (arg === "--session-id" && i + 1 < rawArgs.length) {
      sessionId = rawArgs[++i];
    } else if (arg.startsWith("--session-id=")) {
      sessionId = arg.slice("--session-id=".length);
    } else if (arg === "--scratchpad-dir" && i + 1 < rawArgs.length) {
      scratchpadDir = rawArgs[++i];
    } else if (arg.startsWith("--scratchpad-dir=")) {
      scratchpadDir = arg.slice("--scratchpad-dir=".length);
    } else if (arg === "--cwd" && i + 1 < rawArgs.length) {
      cwd = rawArgs[++i];
    } else if (arg.startsWith("--cwd=")) {
      cwd = arg.slice("--cwd=".length);
    } else if (arg.startsWith("-") && !STRICT_COMMANDS.has(positionals[0]?.toLowerCase())) {
      // Ignore unknown flags for non-strict commands. `check` treats them as
      // text; `ask` rejects them so no flag can override trusted config.
    } else {
      positionals.push(arg);
    }
  }

  const command = positionals[0]?.toLowerCase() || "status";
  return {
    command,
    positionals,
    sessionId,
    scratchpadDir,
    cwd,
    help,
  };
}

function printHelp() {
  console.log(`claude-jev - Semantic guardrails and output verification for Claude Code

Usage:
  claude-jev status [--session-id <id>]
  claude-jev enable --session-id <id>
  claude-jev disable --session-id <id>
  claude-jev mode <shadow|enforce> --session-id <id>
  claude-jev last --session-id <id>
  claude-jev output --session-id <id>
  claude-jev check <text>
  claude-jev ask < request.json

Options:
  --session-id <id>        Exact session ID for session state and toggles
  --scratchpad-dir <dir>   Custom scratchpad/cache directory for session state
  --cwd <dir>              Working directory (defaults to current working directory)
  -h, --help               Show this help message

ask reads one JSON object {"state": ..., "questions": {...}} from stdin
(max ${MAX_DECISION_INPUT_BYTES / 1024} KiB), sends it to the configured TypeSafe model in one
request, and prints {"model", "usage", "answers"} as JSON. It accepts no
model or endpoint override. Exit 2: invalid input. Exit 1: TypeSafe or
configuration error.
`);
}

function formatGateScores(scores) {
  const d = scores?.destructive?.toFixed(2) ?? "n/a";
  const e = scores?.exfiltration?.toFixed(2) ?? "n/a";
  const b = (scores?.beyond_scope ?? scores?.beyondScope)?.toFixed(2) ?? "n/a";
  const i = scores?.impact?.toFixed(2) ?? "n/a";
  const c = scores?.impactConfidence?.toFixed(2) ?? "n/a";
  return `Scores: destructive=${d}, exfiltration=${e}, beyond_scope=${b}, impact=${i} (conf: ${c})`;
}

class StdinTooLargeError extends Error {}

/**
 * Reads stdin as UTF-8, stopping once more than maxBytes arrive so oversized
 * input is never fully buffered.
 */
async function readBoundedStdin(maxBytes) {
  const chunks = [];
  let total = 0;
  for await (const chunk of process.stdin) {
    total += chunk.length;
    if (total > maxBytes) {
      process.stdin.destroy();
      throw new StdinTooLargeError();
    }
    chunks.push(chunk);
  }
  return Buffer.concat(chunks).toString("utf8");
}

/**
 * Describes a failed TypeSafe call by fixed category only: no response body,
 * submitted state, or question text.
 */
function describeTypeSafeFailure(err, model) {
  const code = err instanceof TypeSafeError ? err.code ?? "UNKNOWN" : "UNEXPECTED";
  const status = err instanceof TypeSafeError && err.status !== undefined ? `, HTTP ${err.status}` : "";
  return `no TypeSafe judgment available (${code}${status}) for model ${model}`;
}

function failAsk(message, exitCode) {
  console.error(`Error: ${message}`);
  process.exit(exitCode);
}

async function runAsk(args, cwd) {
  if (args.positionals.length > 1) {
    failAsk("ask takes no arguments or options; send the request JSON on stdin. Model and endpoint come only from ~/.claude/claude-jev.json.", 2);
  }
  if (process.stdin.isTTY) {
    failAsk("ask reads a JSON request from stdin. Usage: claude-jev ask < request.json", 2);
  }

  let input;
  try {
    input = await readBoundedStdin(MAX_DECISION_INPUT_BYTES);
  } catch (err) {
    if (err instanceof StdinTooLargeError) {
      failAsk(`invalid decision request (INPUT_TOO_LARGE): input exceeds ${MAX_DECISION_INPUT_BYTES} bytes`, 2);
    }
    failAsk("could not read stdin", 2);
  }

  const config = loadConfig(cwd);
  let request;
  try {
    request = parseDecisionRequest(input, config.maxStateChars);
  } catch (err) {
    if (err instanceof DecisionInputError) {
      failAsk(`invalid decision request (${err.code}): ${err.message}`, 2);
    }
    throw err;
  }

  if (!canCallTypeSafe(config)) {
    failAsk("Missing TypeSafe API key. Set TYPESAFE_API_KEY environment variable.", 1);
  }

  let response;
  try {
    response = await askTypeSafe({
      model: config.model,
      state: request.state,
      questions: request.questions,
      apiKey: config.apiKey,
      endpoint: config.endpoint,
      timeoutMs: config.timeoutMs,
      retries: config.retries,
    });
  } catch (err) {
    // No answers are fabricated.
    failAsk(describeTypeSafeFailure(err, config.model), 1);
  }

  const output = { model: response.model };
  if (response.usage) output.usage = response.usage;
  output.answers = response.answers;
  console.log(JSON.stringify(output, null, 2));
}

async function main() {
  const args = parseArgs(process.argv.slice(2));

  if (args.help) {
    printHelp();
    return;
  }

  const cwd = args.cwd ? path.resolve(args.cwd) : process.cwd();

  switch (args.command) {
    case "status": {
      const config = loadConfig(cwd);

      let sessionInfo = "Session state: unknown (specify --session-id for exact session state)";
      if (args.sessionId) {
        const store = sessionStore({
          sessionId: args.sessionId,
          scratchpadDir: args.scratchpadDir,
        });
        const overrides = await store.getOverrides();
        const lastGate = await store.getLastVerdict("gate");
        const lastOutput = await store.getLastVerdict("output");

        const effectiveEnabled = overrides.enabled !== undefined ? overrides.enabled : config.gate.enabled;
        const effectiveMode = overrides.mode !== undefined ? overrides.mode : config.gate.mode;

        sessionInfo = [
          `Session ID: ${args.sessionId}`,
          `  Effective gate: ${effectiveEnabled ? "enabled" : "disabled"}`,
          `  Effective mode: ${effectiveMode}`,
          `  Session overrides: enabled=${overrides.enabled !== undefined ? overrides.enabled : "none"}, mode=${overrides.mode ?? "none"}`,
          `  Last gate verdict: ${lastGate ? (lastGate.flagged ? "flagged" : "clear") : "none"}`,
          `  Last output verdict: ${lastOutput ? (lastOutput.flagged ? "flagged" : "clear") : "none"}`,
        ].join("\n");
      }

      console.log(`claude-jev status:
Config:
  Model: ${config.model}
  Gate: ${config.gate.enabled ? "enabled" : "disabled"} (mode: ${config.gate.mode})
  Gate tools: ${config.gate.tools.join(", ")}
  Output: ${config.output.enabled ? "enabled" : "disabled"} (tools: ${config.output.tools.join(", ")})
  API key: ${config.apiKey ? "configured" : isLocalEndpoint(config.endpoint) ? "not configured (not required for local endpoint)" : "not configured"}
  Endpoint: ${isLocalEndpoint(config.endpoint) ? "local" : "remote"}
Session:
  ${sessionInfo}`);
      break;
    }

    case "enable": {
      if (!args.sessionId) {
        console.error("Exact session state is unavailable: --session-id is required for session toggles.");
        process.exit(1);
      }
      const store = sessionStore({
        sessionId: args.sessionId,
        scratchpadDir: args.scratchpadDir,
      });
      await store.setOverrides({ enabled: true });
      console.log(`claude-jev: session ${args.sessionId} gate enabled.`);
      break;
    }

    case "disable": {
      if (!args.sessionId) {
        console.error("Exact session state is unavailable: --session-id is required for session toggles.");
        process.exit(1);
      }
      const store = sessionStore({
        sessionId: args.sessionId,
        scratchpadDir: args.scratchpadDir,
      });
      await store.setOverrides({ enabled: false });
      console.log(`claude-jev: session ${args.sessionId} gate disabled.`);
      break;
    }

    case "mode": {
      const targetMode = args.positionals[1]?.toLowerCase();
      if (targetMode !== "shadow" && targetMode !== "enforce") {
        console.error("Invalid mode: expected 'shadow' or 'enforce'. Usage: claude-jev mode <shadow|enforce> --session-id <id>");
        process.exit(1);
      }
      if (!args.sessionId) {
        console.error("Exact session state is unavailable: --session-id is required for session toggles.");
        process.exit(1);
      }
      const store = sessionStore({
        sessionId: args.sessionId,
        scratchpadDir: args.scratchpadDir,
      });
      await store.setOverrides({ mode: targetMode });
      console.log(`claude-jev: session ${args.sessionId} mode set to ${targetMode}.`);
      break;
    }

    case "last": {
      if (!args.sessionId) {
        console.error("Exact session state is unavailable: --session-id is required to view last verdict.");
        process.exit(1);
      }
      const store = sessionStore({
        sessionId: args.sessionId,
        scratchpadDir: args.scratchpadDir,
      });
      const verdict = await store.getLastVerdict("gate");
      if (!verdict) {
        console.log(`No gate verdict recorded for session ${args.sessionId}.`);
        break;
      }
      console.log(`Last gate verdict for session ${args.sessionId}:`);
      console.log(`  Flagged: ${verdict.flagged ? "YES" : "NO"}`);
      if (Array.isArray(verdict.reasons) && verdict.reasons.length > 0) {
        console.log(`  Reasons: ${verdict.reasons.join(", ")}`);
      }
      if (verdict.scores && typeof verdict.scores === "object") {
        console.log(`  ${formatGateScores(verdict.scores)}`);
      }
      break;
    }

    case "output": {
      if (!args.sessionId) {
        console.error("Exact session state is unavailable: --session-id is required to view last output verdict.");
        process.exit(1);
      }
      const store = sessionStore({
        sessionId: args.sessionId,
        scratchpadDir: args.scratchpadDir,
      });
      const verdict = await store.getLastVerdict("output");
      if (!verdict) {
        console.log(`No output verdict recorded for session ${args.sessionId}.`);
        break;
      }
      console.log(`Last output verdict for session ${args.sessionId}:`);
      console.log(`  Flagged: ${verdict.flagged ? "YES" : "NO"}`);
      console.log(`  Leaks secret: ${verdict.leaksSecret ? "YES" : "NO"}${verdict.leakScore !== undefined ? ` (score: ${verdict.leakScore})` : ""}`);
      console.log(`  Failure class: ${verdict.failureClass ?? "none"}${verdict.failureConfidence !== undefined ? ` (conf: ${verdict.failureConfidence})` : ""}`);
      if (verdict.advice) {
        console.log(`  Advice: ${verdict.advice}`);
      }
      break;
    }

    case "check": {
      const text = args.positionals.slice(1).join(" ").trim();
      if (!text) {
        console.error("Usage: claude-jev check <text>");
        process.exit(1);
      }

      const config = loadConfig(cwd);
      if (!canCallTypeSafe(config)) {
        console.error("Error: Missing TypeSafe API key. Set TYPESAFE_API_KEY environment variable.");
        process.exit(1);
      }

      const boundedInput = boundText(text, config.gate.argumentChars);
      const boundedRequest = boundText(text, 1200);

      const state = buildGateState({
        tool: "Bash",
        tool_input: { command: boundedInput },
        cwd,
        user_request: boundedRequest,
        config,
      });

      try {
        const response = await askTypeSafe({
          model: config.model,
          state,
          questions: GATE_QUESTIONS,
          apiKey: config.apiKey,
          endpoint: config.endpoint,
          timeoutMs: config.timeoutMs,
          retries: config.retries,
        });

        const verdict = evaluateGate(response, config);
        console.log(`Manual check:`);
        console.log(`  Flagged: ${verdict.flagged ? "YES" : "NO"}`);
        if (verdict.reasons.length > 0) {
          console.log(`  Reasons: ${verdict.reasons.join(", ")}`);
        }
        console.log(`  ${formatGateScores(verdict.scores)}`);
      } catch (err) {
        console.error(`Error: ${describeTypeSafeFailure(err, config.model)}`);
        process.exit(1);
      }
      break;
    }

    case "ask": {
      await runAsk(args, cwd);
      break;
    }

    default: {
      console.error(`Unknown command: '${args.command}'. Run 'claude-jev --help' for available commands.`);
      process.exit(1);
    }
  }
}

main().catch((err) => {
  const safeMsg = redact(err?.message || String(err));
  console.error(`Fatal error: ${safeMsg}`);
  process.exit(1);
});
